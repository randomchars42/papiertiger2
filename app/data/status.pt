# Körperlicher Untersuchungsstatus
N: status
I: gemeinsam

E koerpergroesse: number label="Körpergröße" suffix=" cm" min=30 max=250 step=1
E koerpergewicht: number label="Körpergewicht" suffix=" kg" min=1 max=400 step=0.1

G @root @summary @reset @subgroups(break): Status

  S: Normalbefund|n
    Allgemeinzustand = Allgemeinzustand gut
    Pflegezustand = Pflegezustand unauffällig
    Ernährungszustand = Ernährungszustand unauffällig
    Schleimhäute = Schleimhäute feucht
    Zunge = kein Zungenbiss
    Rachen = Rachen reizlos
    Zervikale Lymphknoten = keine vergrößerten zervikalen Lymphknoten tastbar
    Schilddrüse = Schilddrüse nicht vergrößert und schluckverschieblich
    Hautturgor = Hautturgor unauffällig
    Hautzustand = Haut warm und trocken
    Hautbefund = kein Exanthem
    Herztöne = Herztöne rein
    Herzrhythmus = Herzrhythmus regelmäßig
    Herzgeräusche = kein Herzgeräusch auskultierbar
    Thoraxexkursion = Thoraxexkursion seitengleich
    Klopfschall = Klopfschall sonor
    Atemgeräusch = vesikuläres Atemgeräusch seitengleich
    Rasselgeräusche = keine Rasselgeräusche
    Giemen = kein Giemen
    Brummen = kein Brummen
    Bauchdecke = Bauchdecke weich
    Druckschmerz = kein abdomineller Druckschmerz
    Peritonealreizung = kein Hinweis auf Peritonealreizung
    Darmgeräusche = Darmgeräusche regelrecht
    Leber = Leber nicht vergrößert tastbar
    Milz = Milz nicht tastbar
    Nierenlager = kein Nierenlagerklopfschmerz
    Harnblase = Harnblase nicht vergrößert tastbar
    Sphinktertonus = Sphinktertonus regelrecht
    Rektumampulle = keine rektale Resistenz tastbar
    Blutbeimengung = kein Blut am Untersuchungshandschuh
    Stuhlbefund = Stuhl unauffällig
    Perianalbefund = Perianalregion unauffällig
    Ödeme = keine peripheren Ödeme
    Durchblutung = Durchblutung der Extremitäten intakt
    Periphere Pulse = periphere Pulse seitengleich tastbar
    Wunden = keine chronischen Wunden
    Bewusstseinslage = wach und adäquat
    Pupillen = Pupillen isokor und beidseits lichtreagibel
    Sprache = Sprache unauffällig
    Kraft = Kraft seitengleich
    Sensibilität = Sensibilität seitengleich
    Meningismus = kein Meningismus

  G @autocompact @reveal(initial): Allgemeinzustand|-
    P: Allgemeinzustand => Allgemeinzustand gut|n / Allgemeinzustand leicht reduziert|a / Allgemeinzustand deutlich reduziert|a / Allgemeinzustand kritisch|a
    P: Pflegezustand => Pflegezustand unauffällig|n / Pflegezustand reduziert|a / Pflegezustand deutlich reduziert|a
    P: Ernährungszustand => Ernährungszustand unauffällig|n / kachektischer Ernährungszustand @sct=238108007[Cachexia]|a / übergewichtiger Ernährungszustand @sct=238131007[Overweight]|a / adipöser Ernährungszustand @sct=414916001[Obesity]|a
    P: Körpergröße => Körpergröße {:wert=koerpergroesse*:}|-
    P: Körpergewicht => Körpergewicht {:wert=koerpergewicht*:}|-
    P: Ergänzung zum Allgemeinzustand => {:freitext*:}|-

  G @autocompact @reveal(initial): Kopf und Hals|-
    P: Schleimhäute => Schleimhäute feucht|n / Schleimhäute trocken @sct=123640000[Mucous membrane dryness]|a
    P: Zunge => kein Zungenbiss|n / Zungenbiss|a
    P: Rachen => Rachen reizlos|n / Rachen gerötet|a / Tonsillen vergrößert|a / eitrige Tonsillenbeläge|a
    P: Zervikale Lymphknoten => keine vergrößerten zervikalen Lymphknoten tastbar|n / zervikale Lymphknoten links vergrößert tastbar|a / zervikale Lymphknoten rechts vergrößert tastbar|a / zervikale Lymphknoten beidseits vergrößert tastbar|a
    P: Schilddrüse => Schilddrüse nicht vergrößert und schluckverschieblich|n / Schilddrüse vergrößert tastbar|a / Schilddrüse knotig tastbar|a
    P: Ergänzung zu Kopf und Hals => {:freitext*:}|-

  G @autocompact @reveal(initial): Haut|-
    P: Hautturgor => Hautturgor unauffällig|n / Hautturgor vermindert @sct=425244000[Decreased skin turgor]|a
    P: Hautzustand => Haut warm und trocken|n / Haut kühl und trocken|a / Haut heiß und trocken|a / Haut kaltschweißig @sct=83547004[Cold sweat]|a
    P: Hautbefund => kein Exanthem|n / Exanthem @sct=271807003[Rash]|a / Urtikaria @sct=126485001[Urticaria]|a / Petechien @sct=271813007[Petechiae]|a
    P: Ergänzung zur Haut => {:freitext*:}|-

  G @autocompact @reveal(initial): Cor|-
    P: Herztöne => Herztöne rein|n / Herztöne leise|a / Herztöne kaum beurteilbar|-
    P: Herzrhythmus => Herzrhythmus regelmäßig|n / Herzrhythmus unregelmäßig|a
    P: Herzgeräusche => kein Herzgeräusch auskultierbar|n / Systolikum|a / Diastolikum|a / Herzgeräusch: {:freitext*:}|a
    P: Ergänzung zu Cor => {:freitext*:}|-

  G @autocompact @reveal(initial): Pulmo|-
    P: Thoraxexkursion => Thoraxexkursion seitengleich|n / Thoraxexkursion links vermindert|a / Thoraxexkursion rechts vermindert|a
    P: Klopfschall => Klopfschall sonor|n / Klopfschall links gedämpft|a / Klopfschall rechts gedämpft|a / Klopfschall links hypersonor|a / Klopfschall rechts hypersonor|a
    P: Atemgeräusch => vesikuläres Atemgeräusch seitengleich|n / Atemgeräusch links abgeschwächt|a / Atemgeräusch rechts abgeschwächt|a / Atemgeräusch beidseits abgeschwächt|a / Atemgeräusch links aufgehoben|a / Atemgeräusch rechts aufgehoben|a
    P: Rasselgeräusche => keine Rasselgeräusche|n / feinblasige Rasselgeräusche links|a / feinblasige Rasselgeräusche rechts|a / feinblasige Rasselgeräusche beidseits|a / grobblasige Rasselgeräusche links|a / grobblasige Rasselgeräusche rechts|a / grobblasige Rasselgeräusche beidseits|a
    P: Giemen => kein Giemen|n / Giemen @sct=56018004[Wheezing]|a
    P: Brummen => kein Brummen|n / Brummen|a
    P: Ergänzung zu Pulmo => {:freitext*:}|-

  G @autocompact @reveal(initial): Abdomen|-
    P: Bauchdecke => Bauchdecke weich @sct=249543005[Abdomen soft]|n / Bauchdecke angespannt|a / Bauchdecke meteoristisch gespannt|a / Bauchdecke aszitisch gespannt @sct=389026000[Ascites]|a
    P: Druckschmerz => kein abdomineller Druckschmerz @sct=297125009[Abdominal tenderness absent]|n / diffuser abdomineller Druckschmerz @sct=440220007[Generalised abdominal tenderness]|a / Druckschmerz im rechten Oberbauch @sct=448265002[Tenderness of right upper quadrant of abdomen]|a / Druckschmerz im linken Oberbauch @sct=448660000[Tenderness of left upper quadrant of abdomen]|a / Druckschmerz im Epigastrium @sct=301403003[Tenderness of epigastric region]|a / Druckschmerz im rechten Unterbauch @sct=448661001[Tenderness of right lower quadrant of abdomen]|a / Druckschmerz im linken Unterbauch @sct=439774009[Abdominal tenderness of left lower quadrant]|a / Druckschmerz im Mittelbauch @sct=43478001[Abdominal tenderness]|a
    P: Peritonealreizung => kein Hinweis auf Peritonealreizung|n / Abwehrspannung @sct=249545003[Abdominal guarding]|a / Loslassschmerz @sct=35611005[Rebound tenderness]|a / Peritonismus|a
    P: Darmgeräusche => Darmgeräusche regelrecht @sct=61539000[Normal bowel sounds]|n / Darmgeräusche träge|a / Darmgeräusche hochgestellt @sct=18101008[Hyperactive bowel sounds]|a / keine Darmgeräusche @sct=16268000[Bowel sounds absent]|a
    P: Leber => Leber nicht vergrößert tastbar|n / Hepatomegalie|a
    P: Milz => Milz nicht tastbar|n / Splenomegalie|a
    P: Nierenlager => kein Nierenlagerklopfschmerz @sct=413350009:{246090004=102830001},{408729009=410516002},{408731000=410512000},{408732007=410604004}[Known absent: Renal angle tenderness; current; subject of record]|n / Nierenlagerklopfschmerz links @sct=796104681000119101[Left renal angle tenderness]|a / Nierenlagerklopfschmerz rechts @sct=173789951000119107[Right renal angle tenderness]|a / Nierenlagerklopfschmerz beidseits @sct=102830001[Renal angle tenderness]|a
    P: Harnblase => Harnblase nicht vergrößert tastbar|n / Harnblase vergrößert tastbar|a
    P: Ergänzung zum Abdomen => {:freitext*:}|-

  G @inactive @autocompact: Digital-rektale Untersuchung|-
    P: Sphinktertonus => Sphinktertonus regelrecht|n / Sphinktertonus erhöht|a / Sphinktertonus vermindert|a
    P: Rektumampulle => keine rektale Resistenz tastbar|n / rektale Resistenz tastbar|a / Kotsteine tastbar|a
    P: Blutbeimengung => kein Blut am Untersuchungshandschuh|n / Frischblut am Untersuchungshandschuh|a / Teerstuhl am Untersuchungshandschuh|a
    P: Stuhlbefund => Stuhl unauffällig|n / Stuhl mit Blut durchmischt|a / Teerstuhl|a
    P: Perianalbefund => Perianalregion unauffällig|n / Hämorrhoiden|a / Marisken|a / schmerzhafte perianale Schwellung|a
    P: Ergänzung zur digital-rektalen Untersuchung => {:freitext*:}|-

  G @autocompact @reveal(initial): Extremitäten|-
    P: Ödeme => keine peripheren Ödeme @sct=1141974008[No peripheral oedema present]|n / symmetrische Unterschenkelödeme @sct=271809000[Peripheral oedema]|a / generalisierte Extremitätenödeme @sct=271809000[Peripheral oedema]|a / Unterschenkelschwellung links @sct=442672001[Swelling]|a / Unterschenkelschwellung rechts @sct=442672001[Swelling]|a
    P: Durchblutung => Durchblutung der Extremitäten intakt|n / Durchblutung links vermindert|a / Durchblutung rechts vermindert|a / Durchblutung beidseits vermindert|a
    P: Periphere Pulse => periphere Pulse seitengleich tastbar|n / periphere Pulse links abgeschwächt|a / periphere Pulse rechts abgeschwächt|a / periphere Pulse beidseits abgeschwächt|a
    P: Wunden => keine chronischen Wunden @sct=413350009:{246090004=92161000112103},{408729009=410516002},{408731000=410512000},{408732007=410604004}[Known absent: Chronic wound; current; subject of record]|n / chronische Wunde links @sct=92161000112103[Chronic wound]|a / chronische Wunde rechts @sct=92161000112103[Chronic wound]|a / chronische Wunden beidseits @sct=92161000112103[Chronic wound]|a
    P: Ergänzung zu den Extremitäten => {:freitext*:}|-

  G @autocompact @reveal(initial): Neurologie|-
    P: Bewusstseinslage => wach und adäquat|n / schläfrig @sct=79519003[Drowsiness]|a / verwirrt @sct=40917007[Confusion]|a / bewusstlos @sct=418107008[Unconscious]|a
    P: Pupillen => Pupillen isokor und beidseits lichtreagibel|n / Pupillen anisokor @sct=13045009[Anisocoria]|a / Pupillenreaktion verzögert|a / Pupillen lichtstarr @sct=301944006[No pupillary reaction to light]|a
    P: Sprache => Sprache unauffällig @sct=162293002[No speech problem]|n / Dysarthrie @sct=8011004[Dysarthria]|a / Aphasie @sct=87486003[Aphasia]|a / Mutismus @sct=88052002[Mutism]|a
    P: Kraft => Kraft seitengleich|n / Hemiparese links @sct=20022000[Hemiparesis]|a / Hemiparese rechts @sct=20022000[Hemiparesis]|a / Paraparese @sct=1845001[Paraparesis]|a
    P: Sensibilität => Sensibilität seitengleich|n / Hypästhesie links @sct=397974008[Hypoaesthesia]|a / Hypästhesie rechts @sct=397974008[Hypoaesthesia]|a / Hypästhesie beidseits @sct=397974008[Hypoaesthesia]|a
    P: Meningismus => kein Meningismus @sct=274829000[Meningism absent]|n / Meningismus @sct=274830005[Meningism present]|a
    P: Ergänzung zur Neurologie => {:freitext*:}|-
