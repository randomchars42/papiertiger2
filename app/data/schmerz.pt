# Wiederholbare Schmerzanamnese nach OPQRST
N: schmerz
I: gemeinsam

E ort: choice label="Lokalisation" => im Thorax|- / im Oberbauch|- / im Unterbauch|- / im Rücken|- / im Kopf|- / im Arm|- / im Bein|- / diffus|-
E nrs: number label="NRS" min=0 max=10 step=1
E seit: duration label="Beginn" prefix=" seit " units=minute,hour,day,week,month,year default=hour
E qualitaet: choice label="Qualität" => drückend|- / stechend|- / brennend|- / ziehend|- / kolikartig|- / dumpf|-

G @root @reset: Schmerz
  P: Schmerzen => kein Schmerz @sct=413350009:{246090004=22253000},{408729009=410516002},{408731000=410512000},{408732007=410604004}[Known absent: Pain; current; subject of record]|n*

  G @repeat(initial=0,add="Schmerz hinzufügen",empty="Schmerzen") @reset: Schmerz|a
    P: Schmerz => Schmerz @sct=22253000[Pain]|a*
    P<Schmerz>: Schmerzlokalisation => Lokalisation: {:ort=ort*:}|-
    P<Schmerz>: Schmerzbeginn => Beginn{:beginn=seit*:}|-
    P<Schmerz>: Schmerzqualität => Qualität: {:qualitaet=qualitaet*:}|-
    P<Schmerz>: Schmerzstärke => Schmerzstärke NRS {:wert=nrs*:}|-
    P<Schmerz>: Schmerzausstrahlung => Ausstrahlung nach {:freitext*:}|-
    P: Ergänzung zum Schmerz => {:freitext*:}|-
