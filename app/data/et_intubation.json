{
  "version": 2,
  "imports": [
    "gemeinsam"
  ],
  "editors": {
    "et_intubation_eingabe_tubusgroesse": {
      "type": "number",
      "label": "Tubusgröße",
      "prefix": "ID ",
      "suffix": " mm",
      "min": 0,
      "max": 9,
      "step": 0.5
    },
    "et_intubation_eingabe_tubustiefe": {
      "type": "number",
      "label": "Tubustiefe ab Zahnreihe",
      "suffix": " cm",
      "min": 6,
      "max": 35,
      "step": 1
    },
    "et_intubation_eingabe_versuchsanzahl": {
      "type": "number",
      "label": "Intubationsversuche",
      "min": 1,
      "step": 1,
      "default": 1
    },
    "et_intubation_eingabe_sichtbedingungen": {
      "type": "choice",
      "options": {
        "grad_i": {
          "kind": "neutral",
          "text": "Grad I"
        },
        "grad_ii": {
          "kind": "neutral",
          "text": "Grad II"
        },
        "grad_iii": {
          "kind": "neutral",
          "text": "Grad III"
        },
        "grad_iv": {
          "kind": "neutral",
          "text": "Grad IV"
        }
      },
      "label": "Cormack-Lehane-Grad"
    },
    "et_intubation_eingabe_ergaenzung": {
      "type": "multiline",
      "maxRows": 10,
      "label": "Ergänzung zur Intubation",
      "placeholder": "Verlauf, Schwierigkeiten oder weitere Lagekontrolle",
      "rows": 2
    }
  },
  "groups": {
    "et_intubation": {
      "title": "Endotracheale Intubation",
