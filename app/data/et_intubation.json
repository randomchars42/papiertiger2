        {
          "type": "phrase",
          "id": "et_intubation_eintrag_verfahren"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_laryngoskopie"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_intubationshilfe"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_sichtbedingungen"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_intubationsversuche"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_tubusgroesse"
        },
        {
          "type": "phrase",
          "id": "et_intubation_eintrag_tubustiefe"
        },
        {
