{
  "version": 2,
  "editors": {
    "since": {
      "type": "duration",
      "label": "Zeitangabe",
      "prefix": " seit ",
      "units": ["minute", "hour", "day", "week", "month", "year"],
      "defaultUnit": "day"
    },
    "nrs": {
      "type": "number",
      "label": "NRS",
      "prefix": "NRS ",
      "min": 0,
      "max": 10,
      "step": 1
    },
    "side": {
      "type": "choice",
      "label": "Seite",
      "options": {
        "left": { "kind": "neutral", "text": "links" },
        "right": { "kind": "neutral", "text": "rechts" },
        "both": { "kind": "neutral", "text": "beidseits" }
      }
    },
    "severity": {
      "type": "choice",
      "label": "Schweregrad",
      "options": {
        "mild": { "kind": "abnormal", "text": "leicht" },
        "moderate": { "kind": "abnormal", "text": "mittel" },
        "severe": { "kind": "abnormal", "text": "schwer" }
      }
    }
  },
  "groups": {
    "history": {
      "title": "Anamnese",
      "phrases": ["abdominal_pain", "pain_score"]
    }
  },
  "phrases": {
    "abdominal_pain": {
      "title": "Bauchschmerz",
      "kind": "abnormal",
      "default": "",
      "values": {
        "abdominal_pain_present": { "kind": "abnormal", "text": "Bauchschmerz{:onset:}" }
      },
      "attributes": { "onset": "since" }
    },
    "pain_score": {
      "title": "Schmerzstärke",
      "kind": "abnormal",
      "default": "",
      "values": {
        "pain_score_present": { "kind": "abnormal", "text": "Schmerzstärke {:score:}" }
      },
      "attributes": { "score": "nrs" }
    }
  }
}
