# SAMPLER
N: sampler
I: gemeinsam, schmerz, allergie, dauermedikation, vorerkrankungen, symptome

E ort: choice label="Lokalisation" => im Thorax|- / im Oberbauch|- / im Unterbauch|- / im Rücken|- / im Kopf|- / im Arm|- / im Bein|- / diffus|-
E nrs: number label="NRS" min=0 max=10 step=1
E seit: duration label="Beginn" prefix=" seit " units=minute,hour,day,week,month,year default=hour
E dauer: duration label="Dauer" prefix=" für " units=minute,hour,day,week,month,year default=hour
E qualitaet: choice label="Qualität" => drückend|- / stechend|- / brennend|- / ziehend|- / kolikartig|- / dumpf|-
E symptom_seit: duration label="Beginn" prefix=" seit " units=minute,hour,day,week,month,year default=hour
E seite: choice label="Seite" => rechten|- / linken|-

C schmerz: symptome.brustschmerz / symptome.bauchschmerz / symptome.kopfschmerz / symptome.rueckenschmerz / symptome.schulter_arm_schmerz / symptome.bein_hueft_knieschmerz / symptome.gelenkschwellung

G @root: SAMPLER
  G @repeat(initial=0,add="Symptom hinzufügen") @reset @inline: Symptom|a
    P: Symptom* => @values(symptome)
    P: Beginn => Beginn {:beginn=seit*:}|-
    G<schmerz> @collapsed @inline @autocollapse: Provokation
      P: durch Belastung|-
      P: durch Bewegung|-
      P: durch Rotation|-
      P: durch Trauma|-
      P: durch Atembewegung|-
      P: sonstige Provokation => durch {:freitext:}|-
      P: nicht provozierbar|-
    P<durch Trauma>: Trauma => {:freitext:}|-
    G<schmerz> @collapsed @inline @autocollapse: Linderung
      P: durch Ruhe|-
      P: durch Dunkelheit|-
      P: durch Wärme|-
      P: durch Kälte|-
      P: sonstige Linderung => durch {:freitext:}|-
      P: keine|-
    P<schmerz>: Schmerzqualität => Qualität: {:qualitaet=qualitaet*:}|-
    P<schmerz>: Schmerzlokalisation => Lokalisation: {:ort=ort*:}|-
    G<schmerz> @collapsed @inline @autocollapse: Ausstrahlung
      P: in den Rücken|-
      P: zwischen die Schulterblätter|-
      P: in den {:seite:} Arm|- 
      P: in den Hals|-
      P: in den Kiefer|-
      P: in den Unterbauch|-
      P: in die Flanke|-
      P: ins Genital|-
      P: sonstiges => {:freitext:}|-
    P<schmerz>: Schmerzstärke => NRS {:wert=nrs*:}|-
    P: Dauer => Dauer {:dauer*:}|-
    P: Verlauf => zunehmend|- / rückläufig|- / wellenförmig|- / spontanes Sistieren|- / Sistieren unter Analgesie|- / {:freitext:}|-
    P: Freitext => {:freitext*:}|-

  U: allergie

  U: dauermedikation

  U: vorerkrankungen

  G: Letzte
    P<symptome.brustschmerz / symptome.synkope / symptome.atemnot / symptome.herzklopfen>: letzte Koronarangiographie|-

  G: Ereignisvorgeschichte
    P<!symptome.atemnot>: keine Atemnot|n
    P<!symptome.synkope>: keine Synkope|n
    P<!symptome.herzklopfen>: kein Herzklopfen|n
    P<!symptome.fieber>: kein Fieber|n
    P<!symptome.husten>: kein Husten|n
    P<!symptome.uebelkeit>: keine Übelkeit|n
    P<!symptome.erbrechen>: kein Erbrechen|n
    P<!symptome.algurie>: keine Algurie|n
    P<!symptome.pollakisurie>: keine Pollakisurie|n
    P<!symptome.schwindel>: kein Schwindel|n
    P<!symptome.krampfanfall>: kein Krampfanfall|n
    P<!symptome.schwaeche>: keine Schwäche|n
