# Wiederholbare Vitalparameter-Sätze; Scores werden bewusst nicht automatisch berechnet
N: vitalparameter
I: gemeinsam

E atemfrequenz: number label="Atemfrequenz" suffix=" / min" min=0 max=100 step=1
E sauerstoffsaettigung: number label="SpO₂" suffix=" %" min=0 max=100 step=1
E sauerstofffluss: number label="Sauerstofffluss" suffix=" l/min" min=0 max=30 step=0.5
E herzfrequenz: number label="Herzfrequenz" suffix=" / min" min=0 max=300 step=1
E systolisch: number label="Systolischer Blutdruck" suffix=" mmHg" min=0 max=300 step=1
E diastolisch: number label="Diastolischer Blutdruck" suffix=" mmHg" min=0 max=200 step=1
E temperatur: number label="Körpertemperatur" suffix=" °C" min=20 max=45 step=0.1
E blutzucker: number label="Blutzucker" suffix=" mg/dl" min=0 max=1000 step=1
E gcs: number label="GCS-Summe" min=3 max=15 step=1
E news2: number label="NEWS2-Gesamtwert" min=0 max=20 step=1

G @root @reset: Vitalparameter
  P: Vitalparameter => keine Vitalparameter dokumentiert|-
  G @repeat(initial=1,add="Messung hinzufügen",empty="Vitalparameter") @reset: Messung|-
    P: Messzeitpunkt => Vitalparameter um {:zeitpunkt=gemeinsam.ereigniszeitpunkt*:}|-*
    P: Atemfrequenz => Atemfrequenz {:wert=atemfrequenz*:} @sct=86290005[Respiratory rate]|-
    P: Sauerstoffsättigung => periphere Sauerstoffsättigung {:wert=sauerstoffsaettigung*:} @sct=431314004[Peripheral oxygen saturation]|-
    P: Sauerstoffgabe => unter Raumluft|- / unter {:fluss=sauerstofffluss*:} Sauerstoff|i
    P: Herzfrequenz => Herzfrequenz {:wert=herzfrequenz*:} @sct=364075005[Heart rate]|-
    P: Blutdruck => Blutdruck {:systolisch=systolisch*:}/{:diastolisch=diastolisch*:} mmHg @sct=75367002[Blood pressure]|-
    P: Körpertemperatur => Körpertemperatur {:wert=temperatur*:} @sct=386725007[Body temperature]|-
    P: Blutzucker => Blutzucker {:wert=blutzucker*:} @sct=166900001[Glucometer blood glucose]|-
    P: Bewusstseinslage nach ACVPU => wach|n / neu verwirrt @sct=40917007[Confusion]|a / reagiert auf Ansprache|a / reagiert auf Schmerzreiz|a / reagiert nicht @sct=418107008[Unconscious]|a
    P: Glasgow Coma Scale => GCS {:wert=gcs*:} @sct=386557006[Glasgow coma scale finding]|-
    P: NEWS2 => NEWS2 {:wert=news2*:} @sct=1104051000000101[Royal College of Physicians NEWS2 (National Early Warning Score 2) total score]|-
    P: Ergänzung zur Messung => {:freitext*:}|-
