# Wiederholbare Allergien und Unverträglichkeiten
N: allergie
I: gemeinsam

E ausloeser: text label="Auslöser" placeholder="Stoff oder Präparat" prefix=""
E reaktion: text label="Reaktion" placeholder="beobachtete Reaktion" prefix=""

# Häufige oder im Akutkontext besonders relevante Allergien. Die Reihenfolge
# entspricht der erwarteten Nutzungshäufigkeit; die Suche berücksichtigt auch
# Handelsnamen, Stoffklassen und gebräuchliche Patientenangaben.
V penicillin: Allergie gegen Penicillin|a
  @sct=91936005[Allergy to penicillin]
  @alias=Penicillinallergie; Betalaktam; Beta-Laktam
  @tag=antibiotikum

